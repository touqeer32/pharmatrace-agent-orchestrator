NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharmatrace_agents
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5432
AUDIT_DB_NAME=audit_anchor
AUDIT_DB_USER=postgres
AUDIT_DB_PASSWORD=postgres
AUDIT_DB_SSL_MODE=disable
DATABASE_SSL=false
DATABASE_POOL_MAX=15

# Optional: require this value in x-service-api-key for every protected API call.
SERVICE_API_KEY=

# Required only when API keys are submitted to POST /api/v1/llm/connections.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=
SECRET_STORAGE_DIR=.secrets

# Existing environment-backed provider keys may instead be referenced as
# env:OPENAI_API_KEY or env:ANTHROPIC_API_KEY when creating a connection.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional local Ollama provider. Ollama ignores the placeholder API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# PharmaTrace Keycloak defaults. Keep secrets in environment variables, mounted
# files, Vault, or another secret manager. Database rows store references only.
PHARMATRACE_GRAPHQL_URL=https://apigateway.k8s.pharmatrace.io/graphql
KEYCLOAK_TOKEN_URL=https://kc.k8s.pharmatrace.io/auth/realms/first-bucket/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=api
KEYCLOAK_CLIENT_SECRET=
# Same value as the web user's preferred_username.
KEYCLOAK_USERNAME=
KEYCLOAK_PASSWORD=
KEYCLOAK_GRANT_TYPE=password

# Optional controlled on-chain lot anchoring tool. Required only when the
# agent is authorized to run push_lots_to_hedera on Hedera Testnet.
HEDERA_NETWORK=testnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_SIGNER_PRIVATE_KEY=
PHARMATRACE_MANAGER_ADDRESS=
PHARMATRACE_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Serial Number Profile Compliance Agent source API.
SERIAL_PROFILE_API_URL=https://ser-snm.k8s.pharmatrace.io/getAllProfiles
SERIAL_PROFILE_GDTI_API_URL=https://pt-snm-gdti.k8s.pharmatrace.io/graphql
SERIAL_NUMBER_GENERATION_API_URL=https://ser-snm.k8s.pharmatrace.io/downloadSerialNumbers
SERIAL_PROFILE_SENDING_SYSTEM=388e3401-8cbd-42b4-8d9e-a196fc8e5cc6
SERIAL_PROFILE_RECEIVING_SYSTEM=388e3401-8cbd-42b4-8d9e-a196fc8e5cc6
SERIAL_PROFILE_RULE_SET_VERSION=GS1-CONFIG-2026-01
AGENT_REPORT_CREATOR_PUBLIC_KEY=

SCHEDULER_POLL_INTERVAL_MS=15000
EXECUTION_POLL_INTERVAL_MS=3000
EXECUTION_CONCURRENCY=3
MCP_REQUEST_TIMEOUT_MS=30000
# Temporary troubleshooting only; logs raw planner output.
DEBUG_LLM_RESPONSES=false
# Temporary troubleshooting only; logs tenant/tool/request metadata, never tokens.
DEBUG_GRAPHQL_REQUESTS=false
# Temporary troubleshooting only; logs redacted MCP tool responses, truncated at 20,000 characters.
DEBUG_MCP_TOOL_RESULTS=false
